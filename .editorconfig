# EditorConfig configuration for GrannyConverterLibrary
# Based on global project standards.

root = true

[*]
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

# Markdown requires trailing spaces to be kept for line breaks
[*.md]
trim_trailing_whitespace = false

# Visual Studio explicit formatting fallback for C++ headers and sources
[*.{cpp,h,hpp,inl}]
indent_size = 4
indent_style = space
